# ==============================================================================
# CrewAI Recipes Playground — Environment Variables Example
# ==============================================================================
# Copy this file to '.env' and configure your API keys and provider options.
# Changes to '.env' require a restart of the Uvicorn server to take effect.
# ==============================================================================

# Required — Get your free key at https://build.nvidia.com/
LLM_API_KEY=nvapi-your-key-here

# Optional overrides to swap to different LLM providers (e.g. Cerebras, OpenRouter, Gemini, etc.)
# If left commented out, NVIDIA NIM (Llama 3.1 8B) will be used by default.
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_MODEL=meta/llama-3.1-8b-instruct

# Optional: max seconds to wait for one LLM request (default 120). A timed-out
# request is retried up to 3 more times by the SDK (MAX_RETRIES in llm.py), so
# the worst case before an error shows up is about 4 x LLM_TIMEOUT (8 minutes
# at the default). Raise it for slow models, lower it to fail faster.
# LLM_TIMEOUT=120

# ── Example: Cerebras ─────────────────────────────────────────────────────────
# Get key at: https://cloud.cerebras.ai
# LLM_BASE_URL=https://api.cerebras.ai/v1
# LLM_MODEL=llama3.1-8b
# LLM_API_KEY=csk-...

# ── Example: OpenRouter ───────────────────────────────────────────────────────
# Get key at: https://openrouter.ai
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=meta-llama/llama-3.1-8b-instruct:free
# LLM_API_KEY=sk-or-v1-...

# ── Example: Google Gemini ────────────────────────────────────────────────────
# Get key at: https://aistudio.google.com
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-2.5-flash
# LLM_API_KEY=AIza...

# ── Operational Governance & Resilience (#279) ────────────────────────────────
# Circuit Breaker: protects against provider outages and cascade failures
# PLAYGROUND_CIRCUIT_ENABLED=true
# PLAYGROUND_CIRCUIT_FAILURE_THRESHOLD=3
# PLAYGROUND_CIRCUIT_COOLDOWN_SECONDS=30.0

# Token Budget Guard: enforces run-level consumption ceilings (0 disables)
# PLAYGROUND_MAX_RUN_TOKENS=50000
# PLAYGROUND_MAX_RUN_COST=5.0
# PLAYGROUND_TOKEN_WARNING_RATIO=0.8

# Adaptive Backoff: jittered delay on failover smoothing (seconds)
# PLAYGROUND_BACKOFF_BASE_SECONDS=0.5
# PLAYGROUND_BACKOFF_MAX_SECONDS=10.0
# PLAYGROUND_BACKOFF_MAX_RETRIES=3

# Optional Fallback Provider (used automatically when primary circuit trips or rate-limits)
# LLM_FALLBACK_API_KEY=your-fallback-key-here
# LLM_FALLBACK_BASE_URL=https://api.cerebras.ai/v1
# LLM_FALLBACK_MODEL=llama3.1-8b
