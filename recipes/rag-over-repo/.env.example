# Primary LLM Provider Configuration (NVIDIA NIM by default)
LLM_API_KEY=nvapi-your-key-here
LLM_MODEL=meta/llama-3.1-8b-instruct
LLM_BASE_URL=https://integrate.api.nvidia.com/v1

# Optional Secondary / Fallback LLM Provider Configuration
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=meta/llama-3.1-8b-instruct
LLM_FALLBACK_BASE_URL=https://integrate.api.nvidia.com/v1
