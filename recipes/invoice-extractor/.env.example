# NVIDIA NIM API Key (Default provider, free at https://build.nvidia.com)
LLM_API_KEY=nvapi-YOUR_NVIDIA_NIM_KEY

# Optional: Override default model (Default: meta/llama-3.1-8b-instruct)
# LLM_MODEL=meta/llama-3.3-70b-instruct

# Optional: Override base URL (Default: https://integrate.api.nvidia.com/v1)
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1

# Optional: Secondary / Fallback LLM Provider (e.g., OpenRouter, OpenAI, Groq)
# LLM_FALLBACK_API_KEY=sk-or-v1-YOUR_FALLBACK_KEY
# LLM_FALLBACK_MODEL=meta-llama/llama-3.1-70b-instruct
# LLM_FALLBACK_BASE_URL=https://openrouter.ai/api/v1

# Note on System Dependencies for Scanned PDFs / Image OCR:
# Text-based PDFs work out-of-the-box using pypdf.
# If processing scanned PDFs or image files (.png, .jpg, .tiff), Tesseract OCR and Poppler must be installed system-wide:
#   macOS: brew install tesseract poppler
#   Ubuntu/Debian: sudo apt-get install -y tesseract-ocr poppler-utils
#   Windows: Install Tesseract-OCR via installer and add to System PATH
