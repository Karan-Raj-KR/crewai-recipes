# Primary LLM provider (NVIDIA NIM by default)
LLM_API_KEY=your_nvidia_api_key_here
LLM_MODEL=meta/llama-3.1-8b-instruct
LLM_BASE_URL=https://integrate.api.nvidia.com/v1

# Optional fallback LLM provider
# LLM_FALLBACK_API_KEY=your_fallback_api_key_here
# LLM_FALLBACK_MODEL=meta/llama-3.1-70b-instruct
# LLM_FALLBACK_BASE_URL=https://integrate.api.nvidia.com/v1

# Request timeout in seconds (default: 120)
LLM_TIMEOUT=120
