# Copy this file to .env and fill in your values
# Get a free API key at https://build.nvidia.com

# Primary Provider: Your NVIDIA API key (or LLM_API_KEY)
LLM_API_KEY=nvapi-YOUR_NVIDIA_API_KEY_HERE

# Optional Primary Model override (defaults to meta/llama-3.1-8b-instruct)
# LLM_MODEL=meta/llama-3.3-70b-instruct

# Optional: max seconds to wait for one LLM request (default 120). A timed-out
# request is retried up to 3 more times by the SDK (MAX_RETRIES in llm.py), so
# the worst case before an error shows up is about 4 x LLM_TIMEOUT (8 minutes
# at the default). Raise it for slow models, lower it to fail faster.
# LLM_TIMEOUT=120

# Optional: Secondary / Fallback Provider Configuration
# LLM_PROVIDER=primary
# LLM_FALLBACK_API_KEY=sk-or-v1-YOUR_OPENROUTER_KEY_HERE
# LLM_FALLBACK_MODEL=meta-llama/llama-3.1-8b-instruct:free
# LLM_FALLBACK_BASE_URL=https://openrouter.ai/api/v1
